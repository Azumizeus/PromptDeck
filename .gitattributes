# ═══════════════════════════════════════════════════════════════════
#  Fins de ligne — normalisation LF dans le dépôt (fin des warnings CRLF)
#
#  text=auto : git détecte le texte et stocke en LF au commit ;
#  le checkout suit core.autocrlf/eol (aucun réglage = LF partout).
#  Les sections ci-dessous forcent les cas qui doivent être explicites.
# ═══════════════════════════════════════════════════════════════════

* text=auto

# Scripts et code source : LF obligatoire (shebang, exécution Unix/CI)
*.sh        text eol=lf
*.command   text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.plist     text eol=lf
*.toml      text eol=lf

# Fichiers purement Windows : CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binaires : ne jamais convertir (text=auto peut rarement se tromper)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.icns      binary
*.ico       binary
*.zip       binary
*.dmg       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.node      binary
